         this.generateSpecificText(10,"youTubeVidsGuide_description","KATTINSTON IDE A YOUTUBE CSATORNÁNK MEGNYITÁSÁHOZ");
         this.generateSpecificText(10,"smtv_apple","Elérhetõ az Apple App Store-ban");
         this.generateSpecificText(10,"smtv_google","Elérhetõ a Google Play-en");
         this.generateSpecificText(10,"smtv_youtube","Töltsön fel videókat a Youtube csatornánkra!");
         this.generateSpecificText(10,"smtv_battleDawn","Játsszon a Battle Dawn<BR>INGYENES MMO játékunkkal");
         this.generateSpecificText(10,"smtv_BDEA","Play Battle Dawn Earth Arena");
         this.generateSpecificText(10,"tip_1","Online csaták jobb jutalmakat biztosítanak.");
         this.generateSpecificText(10,"tip_2","Néhány Drón használatához Lövedékre vagy Rakétára van szükség.");
         this.generateSpecificText(10,"tip_3","Energia Pajzsok részben elnyelik a károkat energiafelhasználás által.");
         this.generateSpecificText(10,"tip_4","Hõ Pajzsok részben elnyelik a károkat hõ generálása által.");
         this.generateSpecificText(10,"tip_5","Hívjon meg egy barátot és adja meg neki az egyik Ajándék Kulcsát, hogy mindketten bónuszokat szerezzenek.");
         this.generateSpecificText(10,"tip_6","Ajándék Kulcs felhasználása segítségével három Ezüst Láda lehet a jutalma.");
         this.generateSpecificText(10,"tip_7","Különbozõ taktikák mûkõdnek különbozõ ellenfelek ellen. Az új taktikákat tesztelni tudod az Egyjátékos módban.");
         this.generateSpecificText(10,"tip_9","A motor túlmelegedése autómatikus lekapcsoláshoz vezet.");
         this.generateSpecificText(10,"tip_10","Ha szereti a közelharcot, bizonyosodjon meg róla, hogy használ Kardot, Lángszórót, Horgot és Gyorsítót.");
         this.generateSpecificText(10,"tip_11","Amikor kifogy az Energiából, az Elektromos Pajzs automatikusan kikapcsolt.");
         this.generateSpecificText(10,"tip_12","Amikor a motorja túlmelegszik a Hõ Pajzs automatikusan kikapcsol.");
         this.generateSpecificText(10,"tip_13","Használja a Fúziós Magot (Fejlesztés Opció), hogy fejlessze a tárgyait.");
         this.generateSpecificText(10,"tip_14","Ha kilép egy online csatából nem kap semmilyen jutalmat.");
         this.generateSpecificText(10,"tip_15","Találhat Ritka, Epikus és Legendás tárgyakat minden Ládában.");
         this.generateSpecificText(10,"tip_16","Ha sarokba szorult ugorja át az ellenfelét vagy használja a teleportot.");
         this.generateSpecificText(10,"tip_17","Taposás és a Kard használata egy körön belül nagyon hatékony támadás.");
         this.generateSpecificText(10,"tip_18","Bizonyosodjon meg róla, hogy kellõen megvizsgálta az ellenfele fegyvereit azzal, hogy a kurzor segítségével átnézi annak a statisztikáit.");
         this.generateSpecificText(10,"tip_19","Ha végre tud hajtani még egy mûveletet az adott körben, de hatótávolságon kívül vannak a fegyverei, használja a Lekapcsolás funkciót vagy használjon egy felszerelést.");
         this.generateSpecificText(10,"tip_20","Ne engedje, hogy az ellenfele túlmelegítse. Használja bölcsen a motor lekapcsolása funkciót.");
         this.generateSpecificText(10,"tip_22","Többjátékos csatában az a játékos kezd, akinek alacsonyabb a rangja.");
         this.generateSpecificText(10,"tip_23","A három legjobb klán mítikus tárgyakat nyer minden héten.");
         this.generateSpecificText(10,"tip_24","Hozzon létre több, különbözõ típusú mech-t a különbözõ típusú stratégiák kidolgozásához.");
         this.generateSpecificText(10,"tip_25","Kitudja választani bármelyik játékost a Chatben és megtekintheti a visszajátszásait, eredményeit és a klánjának a tagjait.");
         this.generateSpecificText(10,"tip_26","Kitudja választani bármelyik játékost a Ranglistán és megtekintheti a visszajátszásait, eredményeit és a klánjának a tagjait.");
         this.generateSpecificText(10,"tip_27","Az ellenállást lehet növelni és csökkenteni is.");
         this.generateSpecificText(10,"tip_28","Mikor energia kárt okoz az ellenfelének, aneki már nincsen fennmaradt energiája, akkor az energia kár elektromos kárrá alakul így okozva további károkat.");
         this.generateSpecificText(10,"tip_29","Lehet 3 különbözõ mech-je, miután elért a 10. szintet. Használja õket arra, hogy különbözõ taktikákat dolgozzon ki.");
         this.generateSpecificText(10,"tip_30","Meghívni játékosokat privát csatákra nem ad semmiféle jutalmat, viszont jó móka!");
         this.generateSpecificText(10,"tip_31","Jelentkezzen be minden nap, hogy megkapja a napi bónuszt!");
         this.generateSpecificText(10,"tipWeb_1","Tudta, hogy a SuperMechs elérhetõ az iTunes-on?");
         this.generateSpecificText(10,"tipWeb_2","Amennyiben vásárol egy zseton csomagot, abban az esetben ezeket a zsetonokat felhasználhatja a BattleDawn nevû játékunkban is.");
         this.generateSpecificText(10,"tip_34","Látogassa a fórumot rendszeresen, hogy tudomást szerezhesseh a legfrissebb fejlesztésekrõl. Egyszerûen csak használja a SuperMechs fiókját, hogy bejelentkezzen.");
         this.generateSpecificText(10,"tip_35","Kövesse a SuperMechs-t a Facebookon, hogy tudomást szerezzen a legfrissebb hírekrõl és folyamatban lévõ versenyekrõl.");
         this.generateSpecificText(10,"tip_36","Hirdessétek a SuperMech-t!Ha van menõ videója vagy képe, abban az esetben küldje a contact@tacticsoft.net címre és talán jutalmat is kap!");
         this.generateSpecificText(10,"tip_37","Eltudja némítani a többi játékost a Chat-en.");
         this.generateSpecificText(10,"tip_38","Soha ne adja meg a jelszavát senkinek!");
