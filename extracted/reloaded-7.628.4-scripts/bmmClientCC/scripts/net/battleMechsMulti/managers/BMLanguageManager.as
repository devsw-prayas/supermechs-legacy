         this.generateSpecificText(12,"tip_11","जैसे जैसे आप आगे बढ़ेंगे, दुश्मन और पुख्ता होते जाएंगे, इसलिए अपग्रेड करना और अपने आइटम को ट्रांसफॉर्म करना न भूलें!");
         this.generateSpecificText(12,"tip_12","हमेशा विभिन्न प्रकार की मेक बनावटों और आइटम संयोजनों का उपयोग करें!");
         this.generateSpecificText(12,"tip_13","बूस्टिंग करते समय अतिरिक्त कार्य के लिए उसी श्रेणी (धड़, पैर, साइड हथियार आदि) की आइटमों का उपयोग करें!");
         this.generateSpecificText(12,"tip_14","यदि आप एक ऑनलाइन लड़ाई छोड़ देते हैं, तो आपको कोई इनाम नहीं मिलेगा।");
         this.generateSpecificText(12,"tip_15","बेहतर पुरस्कार पाने के लिए कठिन मिशन चलाएं!");
         this.generateSpecificText(12,"tip_16","यदि आप एक कोने में फंसे हैं, तो अपने दुश्मन पर कूद जाएं या दूर दूर दूर करें।");
         this.generateSpecificText(12,"tip_17","हाथा हथियारों के साथ Stomp संयोजन बहुत प्रभावी है।");
         this.generateSpecificText(12,"tip_18","युद्ध के दौरान अपने दुश्मन के हथियारों का निरीक्षण करने के लिए एक लंबी प्रेस का उपयोग करें");
         this.generateSpecificText(12,"tip_19","यदि आपके पास एक क्रिया बिंदु बचे है और उपयोग करने के लिए सीमा या विशेष आइटमओं में कोई हथियार नहीं है, तो अपनी गर्मी को शांत करने के लिए शटडाउन का उपयोग करें।");
         this.generateSpecificText(12,"tip_20","अपने दुश्मन को आपको शटडाउन में शामिल न करने दें। अपने गर्मी को बुद्धिमानी से प्रबंधित करें");
         this.generateSpecificText(12,"tip_21","पावर किटों को खेती की जा सकती है - उन्हें बढ़ावा दें और वे अधिक शक्ति के लायक होंगे!");
         this.generateSpecificText(12,"tip_22","मल्टीप्लेयर लड़ाई में खिलाड़ी उच्च रैंक के साथ दूसरा शुरू होता है।");
         this.generateSpecificText(12,"tip_23","छोटी कमजोर आइटमओं के साथ धैर्य रखें, वे कुछ महान में बदल सकते हैं!");
         this.generateSpecificText(12,"tip_24","विभिन्न रणनीतियों को विकसित करने के लिए अलग-अलग मेच निर्माण बनाएं");
         this.generateSpecificText(12,"tip_25","आप चैट में प्रत्येक खिलाड़ी का चयन कर सकते हैं और उनकी जांच कर सकते हैं और उनकी रिप्ले, उपलब्धियों और कबीले के सदस्यों को देख सकते हैं।");
         this.generateSpecificText(12,"tip_26","आप प्रत्येक खिलाड़ी को रैंकिंग सूची में चुन सकते हैं और उनकी जांच कर सकते हैं और उनकी रिप्ले, उपलब्धियों और कबीले के सदस्यों को देख सकते हैं।");
         this.generateSpecificText(12,"tip_27","प्रतिरोधों को बढ़ाया जा सकता है और सूखा जाता है।");
         this.generateSpecificText(12,"tip_28","यदि आपके दुश्मन की कोई ऊर्जा नहीं छोड़ी गई है, तो किसी भी ऊर्जा निकास के परिणामस्वरूप नियमित क्षति होगी");
         this.generateSpecificText(12,"tip_29","बेहतर और बेहतर पुरस्कार प्राप्त करने के लिए दैनिक बोनस ले लीजिए!");
         this.generateSpecificText(12,"tip_30","निजी लड़ाई के लिए खिलाड़ियों को आमंत्रित करने से आपको कोई इनाम नहीं मिलेगा, लेकिन यह मजेदार है!");
         this.generateSpecificText(12,"tip_31","सुनिश्चित करें कि आप रोज़ रोज़ाना पाने के लिए लॉग इन करें!");
         this.generateSpecificText(12,"tip_32","बूस्टिंग करते समय अतिरिक्त दक्षता के लिए समान प्रकार के आइटम (भौतिक / ऊर्जा / हीट) का उपयोग करें!");
         this.generateSpecificText(12,"tip_33","दुकान में मुफ्त आइटम बक्से एकत्रित करना न भूलें");
         this.generateSpecificText(12,"tip_34","नवीनतम अपडेट के लिए फ़ोरम को देखें। लॉग इन करने के लिए आप अपने सुपरमेक खाते का उपयोग कर सकते हैं।");
         this.generateSpecificText(12,"tip_35","नवीनतम समाचार प्राप्त करने और प्रतियोगिताओं में भाग लेने के लिए फेसबुक पर सुपरमेक को फॉलो करें।");
         this.generateSpecificText(12,"tip_36","सुपर मेक के बारे में प्रचार करें! अगर आपके पास बढ़िया वीडियो या प्रशंसक कला है, तो उन्हें superermechs@tacticsoft.net पर भेजें।");
         this.generateSpecificText(12,"tip_37","आप चैट में अन्य खिलाड़ियों को म्यूट कर सकते हैं।");
         this.generateSpecificText(12,"tip_38","किसी को भी कभी भी अपना पासवर्ड न दें!");
         this.generateSpecificText(12,"tip_39","जब आपके आइटम अधिकतम स्तर तक पहुंच जाते हैं, तो उन्हें ट्रांसफॉर्म किया जा सकता है!");
         this.generateSpecificText(12,"tip_40","अलग-अलग आइटमों के अलग-अलग आंकड़े हैं, स्वास्थ्य, क्षति और वजन से परे देखें!");
         this.generateSpecificText(12,"tip_41","किसी आइटम को ट्रांसफ़ॉर्म करने से कभी भी उसका वजन नहीं बदलता है - नया आइटम हमेशा बेहतर होता है!");
         this.generateSpecificText(12,"tip_42","नए आइटम आजमाने से कभी न हिचकिचाएं, आप शायद जितना सोच सकते हैं उससे ज्यादा इन्हें पसंद करेंगे!");
         this.generateSpecificText(12,"tip_43","मिशन बेस में पिकअप इकठ्ठे कीजिये। वे युद्ध की दिशा बदल सकते हैं!");
         this.generateSpecificText(12,"tip_44","इन्वेंट्री स्पेस ख़त्म हो रहा है? आइटम बूस्ट करें या अतिरिक्त स्थान खरीदें!");
